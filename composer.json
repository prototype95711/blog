{
    "name": "team/blog",
    "description": "Small blog",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "scssphp/scssphp": "^1.12",
        "smarty/smarty": "^5.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.99"
        }
    }
}
